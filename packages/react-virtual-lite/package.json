{
  "name": "react-virtual-lite",
  "version": "2.0.2",
  "description": "A lightweight virtual list library for React",
  "license": "MIT",
  "author": "Andrii Tereshchuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-m-atereshchuk/react-virtual-list.git",
    "directory": "packages/react-virtual-lite"
  },
  "bugs": {
    "url": "https://github.com/i-m-atereshchuk/react-virtual-list/issues"
  },
  "homepage": "https://github.com/i-m-atereshchuk/react-virtual-list/tree/main/packages/react-virtual-lite#readme",
  "keywords": [
    "react",
    "react-list",
    "virtual-list",
    "virtual-scroll",
    "virtual-scroller",
    "virtualization",
    "windowing",
    "infinite-scroll",
    "large-list",
    "dynamic-height",
    "fixed-size",
    "horizontal-scroll"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
