{
  "name": "react-virtual-list-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "preview": "pnpm --filter playground preview",
    "build": "pnpm --filter react-virtual-lite build && pnpm --filter playground build",
    "build:lib": "pnpm --filter react-virtual-lite build",
    "build:playground": "pnpm --filter playground build",
    "typecheck": "pnpm --filter react-virtual-lite typecheck && pnpm --filter playground typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "benchmark": "pnpm --filter playground benchmark",
    "test:e2e": "pnpm --filter playground test:e2e",
    "test": "pnpm --filter react-virtual-lite test"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
