{
  "name": "react-virtual-list-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "concurrently -n library,playground \"pnpm --filter react-virtual-list dev\" \"pnpm --filter playground dev\"",
    "build": "pnpm -r build",
    "build:lib": "pnpm --filter react-virtual-list build",
    "build:playground": "pnpm --filter playground build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "10.0.4",
    "typescript": "5.9.3"
  }
}