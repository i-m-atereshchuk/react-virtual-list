{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,

    "jsx": "react-jsx",

    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true
  }
}
